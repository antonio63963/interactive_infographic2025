include ../../common/ui/appHeaderDetails/appHeaderDetails.pug
include ../../common/ui/popupPage/popupPage.pug

mixin tablePapersItem(options)
  -const {title, researcher, date} = options || {};

  .table-paper-item(class!= attributes.class)
    p.title= title 
    p.researcher= researcher 
    p.date= date

mixin PolicyPapersPage()
  +popupPage({
    title: 'Policy Research Papers', 
    closeClass: 'policyPapersClose',
    headerColor: '#FFE1D0',
    buttonColor: '#FFCCAF'
    })(class="policyPapersPage")

    .container-policy-papers 
      .top-policy-papers 
        img.top-lse-logo(src=require("../../assets/svg/policyPapers/londonSchool.svg"))
        img.top-arrow(src=require("../../assets/svg/policyPapers/arrowRight.svg"))
        .top-info-row 
          img(src=require('../../assets/svg/searchList.svg'))
          span.num 8
          span.text Policy Research Papers
      .table-papers 
        .table-papers-head 
          p.col.title-mobile-col Papers
          p.col.title-col Paper Title
          p.col.researcher-col Researcher
          p.col.date-col Date Published
        +tablePapersItem({
          title: 'Worldviews and Attitudes to Science in Kuwait: The Engagement Threshold Hypothesis',
          researcher: 'Martin W. Bauer, Mohammad Sartawi and Gordon Sammut',
          date: 'June 2024'
        })  
        +tablePapersItem({
          title: 'The Climate Change Risk Reduction Trap: Low Carbon Spatial Economic Restructuring and Disaster Risk in Kuwait',
          researcher: 'Viktor Rözer, Sara Mehryar and Mohammad M. Alsahli',
          date: 'May 2024'
        })  
        +tablePapersItem({
          title: 'Spatial Patterns and Urban Governance in Kuwait: Exploring the Links Between the Physical, the Socio-Economic and the Political',
          researcher: 'Nuno F. da Cruz, Dhari S. Alrasheed, Muneerah Alrabe and Abdullah al-Khonaini',
          date: 'April 2024'
        })  
        +tablePapersItem({
          title: 'Greening Systems by Greening Religion: Eco-Islamic Values and Water-Energy-Nature Nexus Policies in Kuwait',
          researcher: 'Ganga Shreedhar, Davide Contu, Patricia Freitag, Aseel Takshe and Susana Mourato',
          date: 'March 2024'
        })   
