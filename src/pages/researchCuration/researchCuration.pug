include ../../common/ui/appHeaderDetails/appHeaderDetails.pug
include ../../common/ui/sidebarIconItem/sidebarIconItem.pug
include ../../common/ui/popupPage/popupPage.pug
include ../../common/ui/labelWithColor/labelWithColor.pug
include ../../common/ui/lineWithDotInfo/lineWithDotInfo.pug
include ../../common/ui/barChartItem58/barChartItem58.pug


mixin ResearchCurationPage()
  +popupPage({
    title: 'Research - Capacity Building Curations', 
    closeClass: 'researchCurationClose',
    headerColor: '#D6EDFF',
    buttonColor: '#B4DFFF'
    })(class="researchCurationPage")

    .container-researchCuration 
      .sidebar-horizontal(class="sidebar-research-curation sidebar-three-items sb-research-curr-flex")
        +sidebarIconItem({
          num: 3, 
          title: 'Events',
          color: '#569FD6', 
          icon: 'folderStarBlue'
          })(class="sidebar-vertical-item moveToRight")
        +sidebarIconItem({
          num: 221, 
          title: 'Beneficiaries',
          color: '#569FD6', 
          icon: 'persons'
          })(class="sidebar-vertical-item moveToRight")
        +sidebarIconItem({
          num: '3.3k', 
          title: 'KD Amount Approved',
          color: '#569FD6', 
          icon: 'kdBlue'
          })(class="sidebar-vertical-item moveToRight")
      .divider-horizontal

      .research-curation-content 
        h2.research-curation-title Beneficiaries 
        .chart 
          .research-curation-binefic-graph
            .item-s-cur.scaleX.communicating
            .item-s-cur.scaleX.scopus
            .item-s-cur.scaleX.public
          .research-curation-binefic-info
            +barChartItem58({title: 'Getting Published: Effectively Communicating Your Research', num: 166,  percent: '100%'})
            +barChartItem58({title: 'Scientific CV writing workshop – CERN Summer Program 2025', num: 35,  percent: '25%'})
            +barChartItem58({title: 'Surveillance of Physical Activity and Health Outcomes', num: 20,  percent: '18%'})

