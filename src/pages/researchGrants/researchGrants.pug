include ../../common/ui/appHeaderDetails/appHeaderDetails.pug
include ../../common/ui/sidebarIconItem/sidebarIconItem.pug
include ../../common/ui/popupPage/popupPage.pug
include ../../common/ui/fillBarItem/fillBarItem.pug
include ../../common/ui/iconHiveItem/iconHiveItem.pug

mixin ResearchGrantsPage()
  +popupPage({
    title: 'Research Grants', 
    closeClass: 'researchGrantsClose',
    headerColor: '#FFE4C1',
    buttonColor: '#FFCF90'
    })(class="researchGrantsPage")

    .container-researchGrants 
      +sidebarHorizontal()(class="sidebar-research-grants")
        ul 
          li
            span.year 2023 - 
            span.text  Cycle 1
          li
            span.year 2023 - 
            span.text Cycle 2 
        .icons-row
          +sidebarIconItem({
            num: 177, 
            title: 'Proposals Received',
            color: '#F47D39', 
            icon: 'personInputOrange'
            })(class="sidebar-horizontal-item moveToRight")
          +sidebarIconItem({
            num: '93', 
            title: 'Proposals Approved',
            subtitle: '*Includes proposals from previous cycles',
            color: '#F47D39', 
            icon: 'personCheckedOrange'
            })(class="sidebar-horizontal-item moveToRight")
            //- span.subtitle-sidebar-item 
          +sidebarIconItem({
            num: '1.89M', 
            title: 'KD Amount Approved',
            color: '#F47D39', 
            icon: 'kdOrange'
            })(class="sidebar-horizontal-item moveToRight")
          +sidebarIconItem({
            num: '74', 
            title: 'Reports Submitted and Reviewed',
            subtitle: '*Including Final and Progress Reports',
            color: '#F47D39', 
            icon: 'barsCheckedOrange'
            })(class="sidebar-horizontal-item moveToRight")
          +sidebarIconItem({
            num: '110', 
            title: 'Publications',
            color: '#F47D39', 
            icon: 'soundOrange'
            })(class="sidebar-horizontal-item moveToRight")
          +sidebarIconItem({
            num: '44', 
            title: 'Q1 Publications',
            color: '#F47D39', 
            icon: 'qOrange'
            })(class="sidebar-horizontal-item moveToRight")
          +sidebarIconItem({
            num: '30', 
            title: 'Q2 Publications',
            color: '#F47D39', 
            icon: 'q2orange'
            })(class="sidebar-horizontal-item moveToRight")


      .research-grants-institution
        h2.institution-title Applications Breakdown institution
        .institution-chart 

          +fillBarItem({
            num: 32, 
            text: 'Kuwait Institute for Scientific Research', 
            fillPercent: '100%'
            })(class="research-grants-chart-item")
          +fillBarItem({
            num: 21, 
            text: 'Kuwait University', 
            fillPercent: '73%'
            })(class="research-grants-chart-item")
          +fillBarItem({
            num: 10, 
            text: 'Australian University of Kuwait', 
            fillPercent: '35%'
            })(class="research-grants-chart-item")
          +fillBarItem({
            num: 9, 
            text: 'Gulf University for Science and Technology', 
            fillPercent: '33%'
            })(class="research-grants-chart-item")
          +fillBarItem({
            num: 7, 
            text: 'American International University', 
            fillPercent: '30%'
            })(class="research-grants-chart-item") 
          +fillBarItem({
            num: 5, 
            text: 'Ministry of Health', 
            fillPercent: '24%'
            })(class="research-grants-chart-item")

          //- +fillBarItem({
          //-   num: 6, 
          //-   text: 'Arab Open University', 
          //-   fillPercent: '10%'
          //-   })(class="research-grants-chart-item")

          +fillBarItem({
            num: 3, 
            text: 'American University of Kuwait', 
            fillPercent: '20%'
            })(class="research-grants-chart-item")

          +fillBarItem({
            num: 2, 
            text: 'Public Authority for Applied Educ...', 
            fillPercent: '14%'
            })(class="research-grants-chart-item")
          +fillBarItem({
            num: 2, 
            text: 'Kuwait College of Science and Tech...', 
            fillPercent: '14%'
            })(class="research-grants-chart-item")
          //- +fillBarItem({
          //-   num: 2, 
          //-   text: 'Dasman Diabetes Institute', 
          //-   fillPercent: '4%'
          //-   })(class="research-grants-chart-item")
          +fillBarItem({
            num: 1, 
            text: 'Kuwait Environment Protection Soclety', 
            fillPercent: '7%'
            })(class="research-grants-chart-item")
          +fillBarItem({
            num: 1, 
            text: 'Kuwait Municipality', 
            fillPercent: '7%'
            })(class="research-grants-chart-item")
      h2.domain-title Applications Breakdown domain 
      .domain-row 
        .domain-col 
          .domain-info 
            .domain-num 56
            .domain-text Applied Research        
          .domain-info 
            .domain-num 24
            .domain-text Basic Research       
          .domain-info 
            .domain-num 13
            .domain-text Young researchers
        .domain-icons-hive
          +iconHiveItem({
            icon: 'energy', 
            percent: '23%', 
            text1: 'Energy'
            })(class="research-grants-icon-hive energy toTop")
          +iconHiveItem({
            icon: 'health', 
            percent: '18%', 
            text1: 'Health',
            isReverse: true,
            })(class="research-grants-icon-hive health toTop")
          +iconHiveItem({
            icon: 'other', 
            percent: '17%', 
            text1: 'Other'
            })(class="research-grants-icon-hive other toTop")
          +iconHiveItem({
            icon: 'leaf', 
            percent: '16%', 
            text1: 'Environment',
            isReverse: true,
            })(class="research-grants-icon-hive environment toTop")
          +iconHiveItem({
            icon: 'digital', 
            percent: '9%', 
            text1: 'Digital',
            text2: 'Transformation',
            })(class="research-grants-icon-hive digital toTop")
          +iconHiveItem({
            icon: 'food', 
            percent: '6%', 
            text1: 'Food',
            text2: 'Security',
            isReverse: true,
            })(class="research-grants-icon-hive food toTop")
          +iconHiveItem({
            icon: 'water', 
            percent: '9%', 
            text1: 'Water',
            isReverse: true,
            })(class="research-grants-icon-hive water toTop")
          +iconHiveItem({
            percent: '2%', 
            text1: 'Education',
            isReverse: true,
            })(class="research-grants-icon-hive education toTop")
              .custom-icon-cirle

