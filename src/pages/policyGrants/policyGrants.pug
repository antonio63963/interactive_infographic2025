include ../../common/ui/appHeaderDetails/appHeaderDetails.pug
include ../../common/ui/popupPage/popupPage.pug
include ../../common/ui/sidebarHorizontal/sidebarHorizontal.pug
include ../../common/ui/sidebarIconItem/sidebarIconItem.pug
include ./mixins/policy_grants_tr.pug

mixin PolicyGrantPage()
  +popupPage({
    title: 'Policy Research Grants', 
    closeClass: 'policyGrantClose',
    headerColor: '#FFE4C1',
    buttonColor: '#FFCF90'
    })(class="policyGrantPage")

    .container-policy-grants  
      +sidebarHorizontal()(class="policyGrant__sidebar sidebar-three-items")  
        +sidebarIconItem({
          num: 13, 
          title: 'Proposals Received', 
          color: '#F47D39', 
          icon: 'folderStarOrange'
          })(class="sidebar-vertical-item policy-grant-icon moveToRight")
        +sidebarIconItem({
          num: '3*', 
          title: 'Proposals Approved',
          subtitle: '*Includes proposals from previous cycles', 
          color: '#F47D39', 
          icon: 'personCheckedOrange'
          })(class="sidebar-vertical-item policy-grant-icon moveToRight")
        +sidebarIconItem({
          num: '22.1k', 
          title: 'KD Amount Approved', 
          color: '#F47D39', 
          icon: 'kdOrange'
          })(class="sidebar-vertical-item policy-grant-icon moveToRight")

      .content-policy-grant 
        img.policy-grant-icon.moveToRight(src=require('../../assets/svg/policyGrants/domain.svg'))
        .policy-grant-col 
          h2.col-title Applications Breakdown domain
          ul.domains-list
            +policyGrantsTR({
              text1: 'Project', 
              text2: 'Principle Investigator\n(PI) institute', 
              text3: 'Domain', 
              isBold: true
              })(class="domain-item moveUp")
            +policyGrantsTR({
              text1: 'Developing Food Security Scenarios for Kuwait: An Integrated Assessment Applying A Dynamic Computable General Equilibrium Model.', 
              text2: 'KISR', 
              text3: 'Water & food security', 
              })(class=" domain-item moveUp")
            +policyGrantsTR({
              text1: 'Building Information Modeling in the Practice of Architecture/ Engineering Firms: An Adoption Roadmap in the Context of Kuwait.', 
              text2: 'Kuwait University', 
              text3: 'Digital transformation & 4th industrial revolution', 
              })(class="domain-item moveUp")
            +policyGrantsTR({
              text1: 'The AI paradigm shift: Reshaping assessment strategies in higher education.', 
              text2: 'Australian University of Kuwait ', 
              text3: 'Education', 
              })(class="domain-item moveUp")
