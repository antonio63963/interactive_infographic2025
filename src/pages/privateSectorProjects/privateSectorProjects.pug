
include ../../common/ui/appHeaderDetails/appHeaderDetails.pug
include ../../common/ui/twoValuesRow/twoValuesRow.pug
include ../../common/ui/popupPage/popupPage.pug
include ../../common/ui/card/card.pug
include ../../common/ui/labelWithColor/labelWithColor.pug


mixin PrivateSectorProjectsPage()
  +popupPage({
    title: 'Private Sector Projects', 
    closeClass: 'privateSectorProjectsClose',
    headerColor: '#FFE1D0',
    buttonColor: '#FFCCAF'
    })(class="privateSectorProjectsPage")

    .content-privateSector-projects
      .privateSector-projects-labels 
        +labelWithColor({color: '#7DC0F1', text: 'New projects in 2024'})
      .container-privateSectorProjects
        +card({
          canvasId: 'privateSector-project-1', 
          percent: '30%', 
          color: '#7DC0F1', 
          description: 'Antimicrobial Plastics', 
          totalAmount: '50K'
          })(class="privateSector-microb")
          img(src=require('../../assets/svg/privateSectorProjects/microb.svg'))
        +card({
          canvasId: 'privateSector-project-2', 
          percent: '50%', 
          color: '#7DC0F1', 
          description: 'Using quantum technology to secure digital communications', 
          totalAmount: '70.1K'
          })(class="privateSector-react")
          img(src=require('../../assets/svg/privateSectorProjects/react.svg'))
        +card({
          canvasId: 'privateSector-project-3', 
          percent: '40%', 
          color: '#7DC0F1', 
          description: 'Reinforced Concrete', 
          totalAmount: '5K'
          })(class="privateSector-brik")
          img(src=require('../../assets/svg/privateSectorProjects/brik.svg'))



